#!/usr/bin/env python3
"""Run a single unchanged generated Java suite in isolated Maven source root.
Records compilation and execution separately, retaining logs & Surefire XML.
"""
import argparse, subprocess, pathlib, shutil, csv, hashlib, re, json, datetime, xml.etree.ElementTree as ET
ROOT=pathlib.Path(__file__).resolve().parents[4] # project root: round2/scripts -> experiment -> hao -> root
FIELDS=['timestamp_utc','model','condition','run','task_id','compile_success','execution_success','combined_success','tests','failures','errors','skipped','classification','source_sha256','log_path','report_xml','model_identifier','interface','access_time_utc','temperature','top_p','max_output_tokens','notes']
def main():
 p=argparse.ArgumentParser();p.add_argument('--workspace',required=True);p.add_argument('--java',required=True);p.add_argument('--task',required=True);p.add_argument('--condition',choices=['p0_resample','checklist_only','checklist_focus'],required=True);p.add_argument('--run',type=int,required=True);p.add_argument('--model',default='chatgpt');p.add_argument('--out',required=True);p.add_argument('--timeout',type=int,default=180);p.add_argument('--model-identifier',default='UNVERIFIED');p.add_argument('--interface',default='UNVERIFIED');p.add_argument('--access-time-utc',default='UNVERIFIED');p.add_argument('--temperature',default='NOT_EXPOSED');p.add_argument('--top-p',default='NOT_EXPOSED');p.add_argument('--max-output-tokens',default='NOT_EXPOSED');args=p.parse_args()
 if not re.fullmatch(r'CE\d{3}',args.task):p.error('task must be CE###')
 work=pathlib.Path(args.workspace).resolve(); src=pathlib.Path(args.java).resolve(); out=pathlib.Path(args.out).resolve() / args.model / args.condition / f'run-{args.run:02}' / args.task;out.mkdir(parents=True,exist_ok=True)
 if not src.is_file():p.error('generated source not found')
 data=src.read_bytes();txt=data.decode('utf-8-sig',errors='replace')
 if not re.search(r'^\s*package\s+org\.example\s*;',txt,re.M):p.error('wrong Java package; output must declare package org.example; do not automatically rewrite it')
 if not re.search(r'public\s+class\s+GeneratedTest_'+args.task+r'\b',txt):p.error('test class mismatch')
 stage=work/'revision-stage'/'org'/'example';shutil.rmtree(work/'revision-stage',ignore_errors=True);stage.mkdir(parents=True,exist_ok=True)
 staged=stage/f'GeneratedTest_{args.task}.java';staged.write_bytes(data)
 (out/'generated.java').write_bytes(data)
 cmd=['mvn.cmd' if __import__('os').name == 'nt' else 'mvn','-B','clean','test','-Prevision-run'];status='UNKNOWN';cp=False;execution=False;tests=failures=errors=skipped=0;report_xml=''
 try:
  result=subprocess.run(cmd,cwd=str(work),text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=args.timeout,errors='replace')
  log=result.stdout; cp=bool(re.search(r'---\s*compiler:[^\n]*:testCompile',log)) and not bool(re.search(r'COMPILATION ERROR|COMPILATION FAILURE',log)) and bool(re.search(r'---\s*surefire:',log))
  xml=work/'target'/'surefire-reports'/('TEST-org.example.GeneratedTest_'+args.task+'.xml')
  if xml.is_file():
   report_xml=str(out/'surefire.xml');shutil.copy2(xml,report_xml)
   root=ET.parse(xml).getroot();tests=int(root.attrib.get('tests',0));failures=int(root.attrib.get('failures',0));errors=int(root.attrib.get('errors',0));skipped=int(root.attrib.get('skipped',0));execution=tests>0 and failures==0 and errors==0
  status='PASS' if cp and execution else ('TEST_FAILURE' if cp and tests>0 else ('COMPILE_FAILURE' if not cp else 'NO_TEST_REPORT'))
 except subprocess.TimeoutExpired as e:log=(e.stdout or b'').decode(errors='replace') if isinstance(e.stdout,bytes) else (e.stdout or '');status='TIMEOUT'
 except FileNotFoundError:log='Maven unavailable on this machine';status='TOOL_UNAVAILABLE'
 (out/'maven.log').write_text(log,encoding='utf-8'); now=datetime.datetime.now(datetime.timezone.utc).isoformat()
 row=dict(timestamp_utc=now,model=args.model,condition=args.condition,run=args.run,task_id=args.task,compile_success=int(cp),execution_success=int(execution),combined_success=int(cp and execution),tests=tests,failures=failures,errors=errors,skipped=skipped,classification=status,source_sha256=hashlib.sha256(data).hexdigest(),log_path=str(out/'maven.log'),report_xml=report_xml,model_identifier=args.model_identifier,interface=args.interface,access_time_utc=args.access_time_utc,temperature=args.temperature,top_p=args.top_p,max_output_tokens=args.max_output_tokens,notes='')
 (out/'result.json').write_text(json.dumps(row,indent=2),encoding='utf-8');print(json.dumps(row,indent=2));return 0 if status=='PASS' else 1
if __name__=='__main__':raise SystemExit(main())
