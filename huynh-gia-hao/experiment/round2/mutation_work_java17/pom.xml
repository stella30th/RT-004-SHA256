<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0          https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>research</groupId>
    <artifactId>classeval-workspace</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
        </dependency>

        
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
            <version>3.6.1</version>
        </dependency>

        
        <dependency>
            <groupId>com.googlecode.json-simple</groupId>
            <artifactId>json-simple</artifactId>
            <version>1.1.1</version>
        </dependency>

        
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>

                <configuration>
                    <includes>
                        <include>**/GeneratedTest_CE*.java</include>
                    </includes>
                    <failIfNoTests>false</failIfNoTests>
                </configuration>
            </plugin>

        <plugin><groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId><version>1.20.6</version><configuration><threads>1</threads><timestampedReports>false</timestampedReports><failWhenNoMutations>false</failWhenNoMutations><mutationThreshold>0</mutationThreshold><mutators><mutator>DEFAULTS</mutator></mutators><outputFormats><value>XML</value><value>HTML</value></outputFormats><targetClasses><param>${pit.targetClass}</param></targetClasses><targetTests><param>${pit.targetTest}</param></targetTests></configuration></plugin></plugins>
    </build>


    
    
    

    <profiles>

        
        <profile>
            <id>chatgpt-p0</id>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>

                        <executions>
                            <execution>
                                <id>add-chatgpt-p0-test-source</id>
                                <phase>generate-test-sources</phase>

                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>

                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/tests-chatgpt-p0</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>


        
        <profile>
            <id>chatgpt-p1</id>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>

                        <executions>
                            <execution>
                                <id>add-chatgpt-p1-test-source</id>
                                <phase>generate-test-sources</phase>

                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>

                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/tests-chatgpt-p1</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>


        
        <profile>
            <id>gemini-p0</id>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>

                        <executions>
                            <execution>
                                <id>add-gemini-p0-test-source</id>
                                <phase>generate-test-sources</phase>

                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>

                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/tests-gemini-p0</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>


        
        <profile>
            <id>gemini-p1</id>

            <build>
                <plugins>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>

                        <executions>
                            <execution>
                                <id>add-gemini-p1-test-source</id>
                                <phase>generate-test-sources</phase>

                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>

                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/tests-gemini-p1</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>


        
        <profile>
            <id>revision-run</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-revision-single-suite</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources><source>${project.basedir}/revision-stage</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>